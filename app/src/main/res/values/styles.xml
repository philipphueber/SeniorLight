<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- For ToggleActivity: no window to see and no animation, so a tap on the app
         icon only switches the light. -->
    <style name="Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
